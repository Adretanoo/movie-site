#: venv/lib/python3.12/site-packages/django_extensions/validators.py:13
msgid "Control Characters like new lines or tabs are not allowed."
msgstr ""
"Управляющие символы, такие как символ новой строки и символ табуляции "
"недопустимы."

#: venv/lib/python3.12/site-packages/django_extensions/validators.py:47
#, fuzzy
